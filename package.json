      "dist/nodes/SecForm4Parser/SecForm4Parser.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/jest": "^29.5.0",
    "eslint": "9.39.4",
    "jest": "^29.5.0",
    "prettier": "3.8.1",
    "release-it": "19.2.4",
    "ts-jest": "^29.1.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "fast-xml-parser": "^4.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
